---
import { site } from '../data/site';
---

<header class="wrap site-header">
  <a class="brand" href="#top" aria-label={`${site.name} home`}>
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle
        cx="50"
        cy="50"
        r="38"
        fill="none"
        stroke="var(--muted)"
        stroke-width="3"
        opacity="0.5"
      />
      <line
        x1="50"
        y1="6"
        x2="50"
        y2="22"
        stroke="var(--accent)"
        stroke-width="9"
        stroke-linecap="round"
      />
    </svg>
    <span>
      {site.name}
      <span class="dot">.</span>
    </span>
  </a>
  <nav class="nav" aria-label="Main">
    <a href="#apps">Products</a>
    <a href="#work">Work with me</a>
    <a href="#about">About</a>
    <a class="nav-cta" href="#work">
      Send an idea
    </a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    position: relative;
    z-index: 2;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand svg {
    width: 26px;
    height: 26px;
  }
  .dot {
    color: var(--accent-text);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 0.9375rem;
  }
  .nav a {
    text-decoration: none;
    color: var(--muted);
  }
  .nav a:hover {
    color: var(--fg);
  }
  .nav .nav-cta {
    color: var(--fg);
    border: 1px solid var(--line);
    padding: 7px 14px;
    border-radius: 10px;
  }
  .nav .nav-cta:hover {
    border-color: var(--muted);
  }
  @media (max-width: 560px) {
    .nav a:not(.nav-cta) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav a {
      transition:
        color 0.15s ease,
        border-color 0.15s ease;
    }
  }
</style>
