---
import { Image } from 'astro:assets';
import { heroImage, site } from '../data/site';
---

<section class="hero">
  <div class="wrap hero-copy">
    <h1>
      Calm softwares for a loud internet<span class="dot">.</span>
    </h1>
    <p class="sub">{site.description}</p>
    <div class="actions">
      <a class="btn" href="#apps">
        See our products
      </a>
      <a class="text-link" href="#work">
        Bring me your idea
      </a>
    </div>
  </div>

  <div class="wrap">
    <div class="hero-stage">
      {heroImage ? (
        <Image
          src={heroImage}
          alt="Our three apps on three phones"
          widths={[800, 1200, 1600]}
          sizes="(min-width: 960px) 920px, 100vw"
          loading="eager"
        />
      ) : (
        <svg
          viewBox="0 0 800 400"
          preserveAspectRatio="xMidYMax slice"
          role="img"
          aria-label="Placeholder for a transparent PNG showing three phones with our apps"
        >
          <g fill="var(--surface)" stroke="var(--muted)" stroke-width="1.5" stroke-dasharray="6 6">
            <rect x="110" y="70" width="190" height="420" rx="30" transform="rotate(-8 205 280)" />
            <rect x="500" y="70" width="190" height="420" rx="30" transform="rotate(8 595 280)" />
            <rect x="290" y="24" width="220" height="470" rx="34" />
          </g>
          <rect
            x="372"
            y="40"
            width="56"
            height="14"
            rx="7"
            fill="none"
            stroke="var(--muted)"
            stroke-width="1.5"
          />
          <text x="400" y="190" text-anchor="middle" fill="var(--muted)" class="ph-title">
            THREE-PHONE IMAGE
          </text>
          <text x="400" y="212" text-anchor="middle" fill="var(--muted)" class="ph-note">
            Transparent PNG, 1600 × 800
          </text>
        </svg>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    text-align: center;
  }
  .hero-copy {
    padding-block: 48px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .dot {
    color: var(--accent-text);
  }
  .sub {
    margin: 24px auto 0;
    max-width: 48ch;
    font-size: clamp(1.0625rem, 2.2vw, 1.2rem);
    color: var(--muted);
  }
  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 24px;
  }

  /* Image slot: a transparent PNG of three phones, cropped flush with the section's bottom rule. */
  .hero-stage {
    position: relative;
    margin-top: 56px;
    aspect-ratio: 2 / 1;
  }
  .hero-stage::before {
    content: '';
    position: absolute;
    inset: 8% 4% 0;
    background: radial-gradient(
      ellipse at 50% 100%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 68%
    );
  }
  .hero-stage svg,
  .hero-stage :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
  }
  .ph-title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .ph-note {
    font-family: var(--font-mono);
    font-size: 11px;
  }
  @media (max-width: 640px) {
    .hero-stage {
      aspect-ratio: 4 / 3;
      margin-top: 40px;
    }
  }
</style>
