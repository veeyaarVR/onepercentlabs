---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <span>
      © {year} {site.name}
    </span>
    <span>
      Build with ❤️, from{' '}
      <span class="ta" lang="ta">
        தமிழ்நாடு
      </span>{' '}
      India
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 32px 48px;
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .ta {
    font-family: var(--font-tamil);
  }
</style>
